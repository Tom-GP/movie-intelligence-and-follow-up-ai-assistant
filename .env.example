# ---------- LLM (the model that writes answers) ----------
# Which provider to use: "openai" or "anthropic"
LLM_PROVIDER=openai
# Exact model name from your provider's model list
LLM_MODEL=your-model-name-here
# Only the key for your chosen provider is needed
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# ---------- Embeddings (turn text into vectors) ----------
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# After the model has been downloaded once, uncomment this to skip network
# checks and start faster:
# HF_HUB_OFFLINE=1

# ---------- Vector database (Chroma) ----------
VECTOR_DB_PATH=data/chroma_db
COLLECTION_NAME=movie_subtitles

# ---------- Data and retrieval ----------
SUBTITLES_DIR=data/subtitles
# How many chunks to retrieve per question
TOP_K=8
# Chunk length in seconds (a chunk never exceeds the maximum)
CHUNK_MIN_SECONDS=30
CHUNK_MAX_SECONDS=45

# ---------- Email (SMTP): used ONLY by the MCP email server ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
# A Gmail App Password (16 characters), NOT your normal password
SMTP_PASSWORD=your-app-password-here
EMAIL_FROM=your.address@gmail.com
# Used when the user says "email me"
DEFAULT_RECIPIENT_EMAIL=you@example.com
# true = check and preview emails but never send. Set false to really send.
EMAIL_DRY_RUN=true