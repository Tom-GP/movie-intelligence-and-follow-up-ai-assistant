# ---------- LLM (the model that writes answers) ----------
# Which provider to use: "openai" or "anthropic"
LLM_PROVIDER=openai
# Model name for that provider (check your provider's docs for current names)
LLM_MODEL=your-model-name-here
# Only the key for your chosen provider is needed
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# ---------- Embeddings (turn text into vectors) ----------
# A free local model that downloads automatically the first time
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ---------- Vector database (Chroma) ----------
# Folder where Chroma saves its data
VECTOR_DB_PATH=data/chroma_db
# Name of the "table" (collection) inside Chroma
COLLECTION_NAME=movie_subtitles

# ---------- Data and retrieval ----------
SUBTITLES_DIR=data/subtitles
# How many chunks to retrieve per question
TOP_K=5
# Target chunk length in seconds (we build chunks of about 30-90 s)
CHUNK_MIN_SECONDS=30
CHUNK_MAX_SECONDS=90

# ---------- Email (SMTP) - used ONLY by the MCP email server ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
# A Gmail App Password (16 characters), NOT your normal password
SMTP_PASSWORD=your-app-password-here
# Address shown in the "From" field (usually the same as SMTP_USER)
EMAIL_FROM=your.address@gmail.com
# Used when the user says "email me"
DEFAULT_RECIPIENT_EMAIL=you@example.com
# true = check and preview emails but never send. Set false to really send.
EMAIL_DRY_RUN=true